function(agentkit_preview_embed_skills target)
    set(skill "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../skills/release-presentation")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${skill}/SKILL.md" "${skill}/assets/outline.json")
    file(READ "${skill}/SKILL.md" definition)
    file(READ "${skill}/assets/outline.json" template)
    string(REPLACE "\r\n" "\n" definition "${definition}")
    string(REPLACE "\r\n" "\n" template "${template}")
    string(REGEX MATCH "^---\nname: ([a-z0-9-]+)\ndescription: ([^\n]+)\n---\n" frontmatter "${definition}")
    if (NOT frontmatter OR NOT CMAKE_MATCH_1 STREQUAL "release-presentation")
        message(FATAL_ERROR "Invalid packaged release-presentation Skill metadata")
    endif ()
    set(name "${CMAKE_MATCH_1}")
    set(description "${CMAKE_MATCH_2}")
    string(LENGTH "${frontmatter}" frontmatter_size)
    string(SUBSTRING "${definition}" "${frontmatter_size}" -1 instructions)
    string(SHA256 digest "${definition}\n${template}")
    string(SUBSTRING "${digest}" 0 15 revision)
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/agentkit-skills/${target}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ReleaseSkillData.h.in"
            "${generated}/release_skill_data.h" @ONLY)
    target_include_directories(${target} PRIVATE "${generated}")
endfunction()
