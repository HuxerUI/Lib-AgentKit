function(agentkit_preview_link_navigation target)
    if (WIN32)
        target_link_libraries(${target} PRIVATE shell32)
    elseif (CMAKE_SYSTEM_NAME STREQUAL "Linux")
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(AGENTKIT_PREVIEW_GIO REQUIRED IMPORTED_TARGET gio-2.0)
        target_link_libraries(${target} PRIVATE PkgConfig::AGENTKIT_PREVIEW_GIO)
    endif ()
endfunction()
